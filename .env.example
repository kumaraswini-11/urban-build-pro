# Canonical site URL (metadata, sitemap). Set the real domain on Vercel Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quote-request delivery (features/lead-capture/deliver.ts, D-005 / D-012).
# Resend is used when RESEND_API_KEY is set; all three Resend values are required.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
# Optional: "console" logs leads instead of emailing them (local dev / e2e).
# Refused on Vercel production.
LEAD_DELIVERY=
